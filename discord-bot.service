[Unit]
Description=Discord Claude Bot (DsAiWrapper)
After=network.target

[Service]
Type=simple
WorkingDirectory=__SCRIPT_DIR__
ExecStart=__PYTHON__ __SCRIPT_DIR__/bot.py
Restart=on-failure
RestartSec=10
EnvironmentFile=__SCRIPT_DIR__/.env
Environment=HOME=__HOME__
Environment=PATH=__EXTRA_PATH__:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
StandardOutput=journal+console
StandardError=journal+console
KillSignal=SIGINT

[Install]
WantedBy=default.target
