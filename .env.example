# Discord Bot Token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_token_here

# Guild ID (optional, for faster slash command sync)
# DISCORD_GUILD_ID=

# Claude CLI command name
CLAUDE_CMD=claude-internal

# Base directory for workspace auto-mapping
# Channel #foo -> BASE_DIR/foo
BASE_DIR=/Users/evan

# CLI timeout in seconds
COMMAND_TIMEOUT=300
