# Discord Bot Token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_token_here

# Guild ID (optional, for faster slash command sync)
# DISCORD_GUILD_ID=

# Proxy for the Discord connection only (model APIs are reached directly)
# In docker-compose, point it at the mihomo service, e.g. http://mihomo:7890
# DISCORD_PROXY=

# --- Agent (pi) ---
OPENROUTER_API_KEY=your_openrouter_key
PI_PROVIDER=openrouter
PI_MODEL=deepseek/deepseek-v4.1-flash
# PI_THINKING=medium
COMMAND_TIMEOUT=1800

# Base directory for workspace auto-mapping (overridden to /workspaces in docker)
# Channel #foo -> BASE_DIR/foo
BASE_DIR=/home/youruser/projects

# --- Git inside the container (optional) ---
# GITHUB_TOKEN=
# GIT_PROXY=http://mihomo:7890
# GIT_USER_NAME=
# GIT_USER_EMAIL=

# --- docker-compose host paths (relative to this repo) ---
# WORKSPACES_DIR=..
# DATA_DIR_HOST=../../data
# MIHOMO_DIR=../../mihomo
